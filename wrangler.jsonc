{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kasselmann-call-alerts",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-30",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
